# soloraa_frontend/.env.example
# Copy to .env.local for local development.

# ── Cluster ──────────────────────────────────────────────────────────────────
# 'localnet' | 'devnet' | 'mainnet-beta'. Drives the wallet adapter
# RPC endpoint and the explorer link suffix.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Deployed Solora program id. Defaults to the workspace dev id.
NEXT_PUBLIC_SOLORA_PROGRAM_ID=DfPLBwWW72YKYt81eVUznE1amapTtXroFGTdGqHo1Ttf

# Optional: demo vault pubkey for legacy flows. The current build sends real
# devnet receipts via the Memo program and does not require this to be set.
NEXT_PUBLIC_SOLORA_DEMO_VAULT_PUBKEY=

# ── Mock vs live mode ────────────────────────────────────────────────────────
# 'mock'  -> /api/agent/run streams synthetic events with realistic timing.
# 'live'  -> /api/agent/run shells out to ops.ts demo-local. Requires the
#            relayer + enclave to be running on the same host.
SOLORA_FRONTEND_MODE=mock

# ── Live-mode plumbing (ignored when SOLORA_FRONTEND_MODE=mock) ─────────────
# Enclave HTTP endpoint that the live-mode SSE route forwards intent
# requests to. Must be reachable from wherever Next runs.
SOLORA_ENCLAVE_URL=http://127.0.0.1:8080

# Path to the relayer's ops.ts entry, used when the live SSE route shells
# out to it. Resolved relative to the soloraa_frontend/ directory.
SOLORA_OPS_TS_PATH=../solora_relayer/ops.ts
