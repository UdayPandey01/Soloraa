# Repo-level .env.example.
# Copy to .env and fill in. The relayer (solora_relayer/) and enclave
# (solora_enclave_v2/) each have their own focused .env files in env/.
# Variables here are picked up when scripts source the file at the repo root.

# ── Solana cluster ────────────────────────────────────────────────────────────
# REQUIRED. RPC endpoint the relayer + enclave talk to.
#   localnet  -> http://127.0.0.1:8899
#   devnet    -> https://api.devnet.solana.com
#   mainnet   -> a paid RPC (helius/triton/quicknode); the public mainnet
#               RPC will throttle the demo into oblivion.
SOLANA_RPC_URL=http://127.0.0.1:8899

# OPTIONAL. Override the deployed program ID. Default matches Anchor.toml.
# Source: `target/deploy/solora-keypair.json` after `cargo-build-sbf` and
# `solana-keygen pubkey` on that file.
SOLORA_PROGRAM_ID=8tkBctMGe5CsGQ731t9di9hBjGg7rbMo4VEk8WujvTPS

# ── Keypairs ─────────────────────────────────────────────────────────────────
# REQUIRED. Wallet authority — owns the SoloraWallet PDA, co-signs every
# enclave rotation. Generate with: scripts/gen_keys.sh   (or solana-keygen new)
SOLANA_KEYPAIR_PATH=./keys/authority.json

# REQUIRED for governance flows. Holds the registry-governor key that signs
# attestation proofs. Generated alongside the authority by gen_keys.sh.
# Production: rotate to a multisig or to a key held inside a separate
# attested enclave (recursive attestation).
SOLORA_GOVERNOR_KEYPAIR_PATH=./keys/governor.json

# ── Enclave ──────────────────────────────────────────────────────────────────
# OPTIONAL. URL of a running solora-enclave service. If unset (and no mock
# enclave path is provided), ops.ts falls back to the mock signer at
# solora_relayer/mock_enclave.json. Production should always set this.
SOLORA_ENCLAVE_URL=http://127.0.0.1:8080

# OPTIONAL. Expected enclave Ed25519 pubkey (base58). The relayer compares
# this against the on-chain wallet.enclave_signer to surface mismatches
# loudly — does not affect security on its own (the on-chain program
# is the source of truth).
SOLORA_ENCLAVE_PUBKEY=

# OPTIONAL. Path to the mock enclave keypair used in dev when no real
# enclave is running. Generated by ops.ts on first run.
SOLORA_MOCK_ENCLAVE_PATH=solora_relayer/mock_enclave.json

# ── Measurement registry ─────────────────────────────────────────────────────
# REQUIRED for register-enclave-v2 / demo flows. 32-byte hex (no 0x prefix).
# For local dev you can use any constant; for production this MUST match
# the actual enclave measurement (sha256(PCR0||PCR1||PCR2) for AWS Nitro,
# the image-hash for Marlin Oyster). The off-chain attestation verifier
# computes this from the platform's attestation document.
SOLORA_MEASUREMENT_HASH=

# ── Pyth (only for trade-intent demo) ────────────────────────────────────────
# OPTIONAL. Pyth Hermes endpoint. Default is the public mainnet endpoint;
# devnet has a separate one (https://hermes-beta.pyth.network).
SOLORA_HERMES_URL=https://hermes.pyth.network

# OPTIONAL. Hex-encoded Pyth price feed id (no 0x prefix). Look up at
# https://pyth.network/developers/price-feed-ids. Example below is SOL/USD.
SOLORA_PYTH_FEED_ID=ef0d8b6fda2ceba41da15d4095d1da392a0d2f8ed0c6c7bc0f4cfac8c280b56d

# ── Policy knobs ─────────────────────────────────────────────────────────────
# OPTIONAL. Used by ops.ts when it builds a fresh wallet. The on-chain
# program's CPI allowlist + max trade size + slippage cap are all set from
# these on init-wallet. Override per-call with --max-trade-usdc / --slippage.
SOLORA_MAX_TRADE_USDC=100000
SOLORA_MAX_SLIPPAGE_BPS=50

# ── Intent freshness ─────────────────────────────────────────────────────────
# OPTIONAL. How many slots ahead the signed intent's expiry_slot is set to.
# 60 slots ≈ 25 seconds at 0.4s/slot — enough for normal latency, short
# enough that stale intents never reach the chain. Min: 5. Sane: 30-200.
SOLORA_EXPIRY_SLOTS_AHEAD=60

# OPTIONAL. Same idea but for register-enclave-v2 attestation freshness.
SOLORA_ATTEST_EXPIRY_SLOTS=200

# ── Compute budget ───────────────────────────────────────────────────────────
# OPTIONAL. Per-tx compute unit limit prepended via ComputeBudgetProgram.
# 200000 is enough for execute_transfer; bump for execute_arbitrary_cpi
# with a real DEX target (e.g. 400000 for Jupiter routes).
SOLORA_CU_LIMIT=200000
